# Copy to .env (git-ignored). Placeholder values only - safe for local dev, never for real deployments.
COMPOSE_PROJECT_NAME=drct

# Warehouse Postgres (inside the compose network: host=warehouse, port=5432; host port 5433)
WAREHOUSE_HOST=warehouse
WAREHOUSE_PORT=5432
WAREHOUSE_USER=drct
WAREHOUSE_PASSWORD=drct_dev_password
WAREHOUSE_DB=warehouse
WAREHOUSE_DSN=postgresql://drct:drct_dev_password@warehouse:5432/warehouse

# Admin DSN used by the test harness to create/drop throwaway databases
TEST_ADMIN_DSN=postgresql://drct:drct_dev_password@warehouse:5432/postgres

# Read-only role used by the Streamlit Control Tower (password is applied on first warehouse start)
CONTROL_TOWER_RO_PASSWORD=control_tower_dev_password
CONTROL_TOWER_DSN=postgresql://control_tower_ro:control_tower_dev_password@warehouse:5432/warehouse

# Simulation / ingestion
LANDING_DIR=/opt/drct/landing
DRCT_SEED=42
FX_SOURCE=api
FX_API_URL=https://api.frankfurter.dev/v1

# Airflow 3 (LocalExecutor). AIRFLOW_VERSION also selects the constraints file used at image build.
AIRFLOW_VERSION=3.3.2
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_dev_password
AIRFLOW_DB_NAME=airflow
# Shared by every Airflow container (api-server signs task tokens, the others verify them). Use 64+ chars (HS512).
AIRFLOW_JWT_SECRET=drct-dev-only-jwt-secret-change-me-0123456789-0123456789-0123456789-abcdef
AIRFLOW_API_SECRET_KEY=drct-dev-only-api-secret-key-change-me-0123456789
# dev-only placeholder: generate your own for anything real, e.g. `openssl rand -base64 32 | tr "+/" "-_"`
AIRFLOW_FERNET_KEY=bScjaFRwZzm4sryLV735iiNIonSfsMXBR6eHfHC3chQ=
